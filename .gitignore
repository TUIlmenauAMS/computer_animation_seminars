# ── Virtual environments ──────────────────────────────────────────────────────
# Created by uv sync inside each seminar folder — never commit
.venv/
venv/
env/
ENV/

# ── uv ────────────────────────────────────────────────────────────────────────
.uv/
# uv.lock IS committed — it pins exact dependency versions for reproducibility

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*$py.class
__pypackages__/

# ── C extensions ──────────────────────────────────────────────────────────────
*.so

# ── Build / packaging ─────────────────────────────────────────────────────────
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# ── Linting & type checking ───────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.dmypy.json
.pyre/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ── pyenv ─────────────────────────────────────────────────────────────────────
# .python-version IS committed — it tells uv which Python version to use
# (uncomment the line below only if you stop using uv's Python management)
# .python-version

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
